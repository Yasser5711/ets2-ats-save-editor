{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "src-tauri/target/release/bundle/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "test/**"
      ]
    },
    "package": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "outputs": [
        "../../release/**"
      ],
      "cache": false
    },
    "desktop": {
      "cache": false,
      "persistent": true
    }
  }
}
