{
  "name": "truck-save-editor",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "package": "turbo run package",
    "app": "turbo run build && node packages/server/dist/index.js",
    "dev:web": "pnpm --filter @truck/web dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "desktop": "pnpm --filter @truck/desktop dev",
    "desktop:build": "turbo run build --filter=@truck/web --filter=@truck/server && pnpm --filter @truck/desktop bundle",
    "icon": "node packages/desktop/scripts/make-icon.mjs && pnpm --filter @truck/desktop exec tauri icon packages/desktop/icon-source.png -o src-tauri/icons"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxlint": "^1.79.0",
    "turbo": "^2.6.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
