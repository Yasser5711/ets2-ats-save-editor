{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "capabilities the save editor window needs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-message",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/truck-save-server", "sidecar": true }]
    }
  ]
}
